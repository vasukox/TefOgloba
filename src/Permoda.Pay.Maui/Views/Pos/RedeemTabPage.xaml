<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:Permoda.Pay.Maui.Views.Controls"
             xmlns:behaviors="clr-namespace:Permoda.Pay.Maui.Common.Behaviors"
             xmlns:vmpos="clr-namespace:Permoda.Pay.Maui.ViewModels.Pos"
             x:Class="Permoda.Pay.Maui.Views.Pos.RedeemTabPage"
             x:Name="Root"
             BackgroundColor="{StaticResource Background}"
             Shell.NavBarIsVisible="False"
             Title="Redimir">

    <Grid RowDefinitions="Auto,*">

        <controls:TopBarView Grid.Row="0" ParentText="Inicio" SectionText="Redimir saldo" />

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20,10,20,12" Spacing="10" MaximumWidthRequest="1180">

                <!-- Encabezado de la operación + estado de Ogloba -->
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <VerticalStackLayout Grid.Column="0" Spacing="6">
                        <Label Text="OPERACIÓN"
                               Style="{StaticResource FieldLabel}"
                               TextColor="{StaticResource Primary}" />
                        <Label Text="Redimir saldo"
                               FontSize="26"
                               FontAttributes="Bold"
                               TextColor="{StaticResource TextPrimary}" />
                        <Label Text="Escanea un bono, ingresa el monto a cobrar y agrégalo a la lista."
                               FontSize="12"
                               TextColor="{StaticResource TextSecondary}" />
                    </VerticalStackLayout>

                    <HorizontalStackLayout Grid.Column="1" Spacing="6" VerticalOptions="End">
                        <HorizontalStackLayout.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding Header.CheckConnectivityCommand}" />
                        </HorizontalStackLayout.GestureRecognizers>
                        <Label Text="●" FontSize="10" VerticalOptions="Center">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding Header.ConnectivityState}" Value="online">
                                    <Setter Property="TextColor" Value="{StaticResource Success}" />
                                </DataTrigger>
                                <DataTrigger TargetType="Label" Binding="{Binding Header.ConnectivityState}" Value="offline">
                                    <Setter Property="TextColor" Value="{StaticResource Error}" />
                                </DataTrigger>
                                <DataTrigger TargetType="Label" Binding="{Binding Header.ConnectivityState}" Value="checking">
                                    <Setter Property="TextColor" Value="{StaticResource Accent}" />
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                        <Label Text="{Binding Header.ShortStatusText}"
                               FontSize="12"
                               FontAttributes="Bold"
                               VerticalOptions="Center">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding Header.ConnectivityState}" Value="online">
                                    <Setter Property="TextColor" Value="{StaticResource Success}" />
                                </DataTrigger>
                                <DataTrigger TargetType="Label" Binding="{Binding Header.ConnectivityState}" Value="offline">
                                    <Setter Property="TextColor" Value="{StaticResource Error}" />
                                </DataTrigger>
                                <DataTrigger TargetType="Label" Binding="{Binding Header.ConnectivityState}" Value="checking">
                                    <Setter Property="TextColor" Value="{StaticResource Accent}" />
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                    </HorizontalStackLayout>
                </Grid>

                <!-- Solo cuando el módulo lo levantó HiPOS: por cuánto es la factura, y —en
                     cuanto se escanea el bono— cuánto va a poner el bono y cuánto falta. Las dos
                     cifras juntas son lo que el cajero necesita ANTES de cobrar; enterarse del
                     faltante al procesar es enterarse tarde. -->
                <Border IsVisible="{Binding HasSaleAmountBanner}"
                        Background="{StaticResource HeroBrush}"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 16"
                        Padding="18,14"
                        Margin="0,4,0,4">
                    <Border.Behaviors>
                        <behaviors:RevealBehavior />
                    </Border.Behaviors>
                    <VerticalStackLayout Spacing="12">
                        <Label Text="{Binding SaleAmountBanner}"
                               FontSize="17"
                               FontAttributes="Bold"
                               TextColor="{StaticResource OnHeroMuted}" />

                        <!-- LO QUE FALTA POR PAGAR. Es la cifra que el cajero le dice al cliente,
                             así que es la más grande de la pantalla y NO desaparece: se queda
                             mientras haya una venta que cubrir, con bonos en la lista o sin ellos.

                             Antes esto vivía dentro del bloque del bono recién escaneado, y al
                             agregarlo a la lista se borraba junto con él — justo en el momento en
                             que hace falta, con el cliente enfrente y el cajero por procesar. -->
                        <VerticalStackLayout Spacing="3" IsVisible="{Binding HasCoverage}">
                            <Label Text="{Binding CoverageLabel}"
                                   FontSize="11"
                                   FontAttributes="Bold"
                                   CharacterSpacing="1.5"
                                   TextColor="{StaticResource OnHeroMuted}" />

                            <!-- La cifra y el porcentaje en la misma línea: el número dice cuánto
                                 falta en pesos, el porcentaje cuánto se lleva cubierto. Juntos
                                 responden las dos preguntas que hace el cliente. -->
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <Label Text="{Binding CoverageAmountText}"
                                       FontSize="40"
                                       FontAttributes="Bold"
                                       VerticalOptions="End"
                                       TextColor="{StaticResource OnHero}">
                                    <Label.Triggers>
                                        <!-- Verde lima cuando ya no falta nada: el cajero necesita
                                             distinguir de un vistazo "listo" de "todavía falta". -->
                                        <DataTrigger TargetType="Label" Binding="{Binding IsFullyCovered}" Value="True">
                                            <Setter Property="TextColor" Value="{StaticResource Lime}" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>

                                <Label Grid.Column="1"
                                       Text="{Binding CoveragePercentText}"
                                       FontSize="15"
                                       FontAttributes="Bold"
                                       VerticalOptions="End"
                                       Margin="0,0,0,6"
                                       TextColor="{StaticResource Lime}" />
                            </Grid>

                            <!-- Barra de cobertura: cuánto de la venta llevan puesto los bonos.
                                 Da la proporción de un vistazo, sin leer cifras.

                                 El canal alfa va en el COLOR de la pista, no en Opacity del Border:
                                 Opacity se hereda a los hijos, así que atenuaba también la barra
                                 verde de adentro y la dejaba lavada justo cuando tenía que
                                 destacar.

                                 Progress NO se enlaza: lo anima el code-behind con ProgressTo, para
                                 que la barra crezca en vez de saltar. Ver RedeemTabPage.xaml.cs. -->
                            <Border BackgroundColor="#4DC7CDE9"
                                    HeightRequest="6"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 3"
                                    Margin="0,6,0,0">
                                <ProgressBar x:Name="CoverageBar"
                                             ProgressColor="{StaticResource Lime}"
                                             HeightRequest="6" />
                            </Border>

                            <Label Text="{Binding CoverageDetailText}"
                                   FontSize="13"
                                   LineBreakMode="WordWrap"
                                   Margin="0,6,0,0"
                                   TextColor="{StaticResource OnHeroMuted}" />
                        </VerticalStackLayout>

                        <!-- SALDO DEL BONO recién escaneado. Complementa al panel de arriba: aquel
                             dice cuánto falta de la venta, este cuánto trae la tarjeta que el
                             cajero tiene en la mano. Desaparece al agregarla a la lista, que es
                             cuando deja de ser el bono "en curso". -->
                        <VerticalStackLayout Spacing="2" IsVisible="{Binding HasCardInfo}">
                            <BoxView HeightRequest="1"
                                     Color="{StaticResource OnHeroMuted}"
                                     Opacity="0.35"
                                     Margin="0,2,0,8" />

                            <Label Text="ESTE BONO TIENE"
                                   FontSize="11"
                                   FontAttributes="Bold"
                                   CharacterSpacing="1.5"
                                   TextColor="{StaticResource OnHeroMuted}" />

                            <Label Text="{Binding CardBalanceAmount}"
                                   FontSize="26"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource OnHero}" />

                            <Label Text="{Binding CardOutcomeText}"
                                   FontSize="14"
                                   LineBreakMode="WordWrap"
                                   Margin="0,3,0,0"
                                   TextColor="{StaticResource OnHeroMuted}" />
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- Captura: serial a la izquierda (recibe el scan), monto a la derecha.
                     Dos columnas para que el teclado de la terminal no tape el campo activo. -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="10" RowDefinitions="Auto,Auto" RowSpacing="8">

                    <Label Grid.Row="0" Grid.Column="0" Text="SERIAL DEL BONO" Style="{StaticResource FieldLabel}" />
                    <Label Grid.Row="0" Grid.Column="1" Text="MONTO A REDIMIR (COP)" Style="{StaticResource FieldLabel}" />

                    <Border Grid.Row="1" Grid.Column="0"
                            BackgroundColor="{StaticResource Surface}"
                            Stroke="{StaticResource BorderBrush}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 16"
                            Padding="12,6">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                            <Border Grid.Column="0"
                                    WidthRequest="36" HeightRequest="36"
                                    BackgroundColor="{StaticResource PrimaryTint}"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 12"
                                    VerticalOptions="Center">
                                <Image Source="ic_card.png"
                                       WidthRequest="18" HeightRequest="18"
                                       Aspect="AspectFit"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                            </Border>

                            <Entry x:Name="BarcodeEntry"
                                   Grid.Column="1"
                                   Placeholder="BN-2024-XXXXX"
                                   FontSize="18"
                                   CharacterSpacing="2"
                                   Keyboard="Plain"
                                   BackgroundColor="Transparent"
                                   TextColor="{StaticResource TextPrimary}"
                                   PlaceholderColor="{StaticResource TextMuted}"
                                   Text="{Binding ScannedBarcode, Mode=TwoWay}"
                                   Completed="OnBarcodeCompleted"
                                   VerticalOptions="Center"
                                   IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}">
                                <Entry.Behaviors>
                                    <!-- Escanear otro bono pisa al anterior en vez de concatenarse. -->
                                    <behaviors:ScanReplaceBehavior />
                                </Entry.Behaviors>
                            </Entry>

                            <Border Grid.Column="2"
                                    BackgroundColor="{StaticResource PrimaryTint}"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 12"
                                    Padding="12,9"
                                    VerticalOptions="Center">
                                <Border.GestureRecognizers>
                                    <!-- Deja el cursor en el campo para que el lector wedge
                                         descargue ahí el serial que escanee. -->
                                    <TapGestureRecognizer Tapped="OnScanTapped" />
                                </Border.GestureRecognizers>
                                <HorizontalStackLayout Spacing="7">
                                    <Image Source="ic_search.png"
                                           WidthRequest="16" HeightRequest="16"
                                           Aspect="AspectFit"
                                           VerticalOptions="Center" />
                                    <Label Text="Escanear"
                                           FontSize="12"
                                           FontAttributes="Bold"
                                           TextColor="{StaticResource Primary}"
                                           VerticalOptions="Center" />
                                </HorizontalStackLayout>
                            </Border>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1" Grid.Column="1"
                            BackgroundColor="{StaticResource Surface}"
                            Stroke="{StaticResource BorderBrush}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 16"
                            Padding="12,6">
                        <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="12">
                            <Border Grid.Column="0"
                                    WidthRequest="36" HeightRequest="36"
                                    BackgroundColor="{StaticResource PrimaryTint}"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 12"
                                    VerticalOptions="Center">
                                <Label Text="$"
                                       FontSize="16"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource Primary}"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                            </Border>

                            <Label Grid.Column="1"
                                   Text="$"
                                   FontSize="16"
                                   TextColor="{StaticResource TextMuted}"
                                   VerticalOptions="Center" />

                            <Entry Grid.Column="2"
                                   x:Name="AmountEntry"
                                   Placeholder="45.000"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   Keyboard="Numeric"
                                   BackgroundColor="Transparent"
                                   TextColor="{StaticResource TextPrimary}"
                                   PlaceholderColor="{StaticResource TextMuted}"
                                   Text="{Binding AmountText, Mode=TwoWay}"
                                   VerticalOptions="Center"
                                   IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                                   IsReadOnly="{Binding IsAmountReadOnly}">
                                <Entry.Behaviors>
                                    <behaviors:ThousandsSeparatorBehavior />
                                </Entry.Behaviors>
                                <Entry.Triggers>
                                    <!-- En un cobro de HiPOS el monto lo determina el saldo del
                                         bono contra la factura: se muestra, no se digita. -->
                                    <DataTrigger TargetType="Entry" Binding="{Binding IsAmountReadOnly}" Value="True">
                                        <Setter Property="Placeholder" Value="Escanea el bono" />
                                        <Setter Property="TextColor" Value="{StaticResource Primary}" />
                                    </DataTrigger>
                                </Entry.Triggers>
                            </Entry>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Lote de bonos -->
                <Label Text="{Binding QueueCountText}"
                       FontSize="12"
                       FontAttributes="Bold"
                       TextColor="{StaticResource TextSecondary}"
                       Margin="0,8,0,0"
                       IsVisible="{Binding HasQueueItems}" />

                <!-- Cómo se opera la lista. Va a la vista y no escondido en un gesto que haya que
                     descubrir: el cajero aprende la pantalla en el mostrador, con un cliente
                     enfrente. -->
                <Label Text="Desliza una fila hacia la izquierda para eliminarla · Tócala para editarla"
                       FontSize="11"
                       TextColor="{StaticResource TextMuted}"
                       Margin="0,0,0,6"
                       IsVisible="{Binding HasQueueItems}" />

                <CollectionView ItemsSource="{Binding Queue}" IsVisible="{Binding HasQueueItems}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="vmpos:PendingRedemptionItem">

                            <!-- Deslizar NO borra por sí solo: descubre el botón rojo y hay que
                                 tocarlo (Mode="Reveal"). Son dos gestos deliberados para una
                                 acción destructiva — con un solo deslizamiento, un roce contra el
                                 mostrador borraría un bono ya capturado. -->
                            <SwipeView Margin="0,0,0,8">
                                <SwipeView.RightItems>
                                    <SwipeItems Mode="Reveal">
                                        <SwipeItemView IsEnabled="{Binding IsRemovable}"
                                                       Command="{Binding Source={x:Reference Root}, Path=BindingContext.RemoveFromQueueCommand}"
                                                       CommandParameter="{Binding .}">
                                            <Border BackgroundColor="{StaticResource Error}"
                                                    StrokeThickness="0"
                                                    StrokeShape="RoundRectangle 14"
                                                    Padding="24,0"
                                                    WidthRequest="150">
                                                <VerticalStackLayout Spacing="3"
                                                                     HorizontalOptions="Center"
                                                                     VerticalOptions="Center">
                                                    <Label Text="🗑"
                                                           FontSize="22"
                                                           HorizontalOptions="Center" />
                                                    <Label Text="Eliminar"
                                                           FontSize="13"
                                                           FontAttributes="Bold"
                                                           TextColor="White"
                                                           HorizontalOptions="Center" />
                                                </VerticalStackLayout>
                                            </Border>
                                        </SwipeItemView>
                                    </SwipeItems>
                                </SwipeView.RightItems>

                            <Border Stroke="{StaticResource BorderBrush}"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 14"
                                    Padding="12,9">
                                <!-- Tocar la fila la devuelve al formulario para corregirla. Antes
                                     había que acertarle a una flecha de 18px en la esquina. -->
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={x:Reference Root}, Path=BindingContext.ReturnRowCommand}"
                                        CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <Border.Behaviors>
                                    <behaviors:PulseOnPropertyChangeBehavior PropertyName="Status" />
                                </Border.Behaviors>
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding Status}" Value="Approved">
                                        <Setter Property="BackgroundColor" Value="{StaticResource SuccessTint}" />
                                        <Setter Property="Stroke" Value="{StaticResource SuccessBrush}" />
                                    </DataTrigger>
                                    <DataTrigger TargetType="Border" Binding="{Binding Status}" Value="Rejected">
                                        <Setter Property="BackgroundColor" Value="{StaticResource ErrorTint}" />
                                        <Setter Property="Stroke" Value="{StaticResource ErrorBrush}" />
                                    </DataTrigger>
                                    <DataTrigger TargetType="Border" Binding="{Binding Status}" Value="Pending">
                                        <Setter Property="BackgroundColor" Value="{StaticResource Surface}" />
                                    </DataTrigger>
                                    <DataTrigger TargetType="Border" Binding="{Binding Status}" Value="Processing">
                                        <Setter Property="BackgroundColor" Value="{StaticResource PrimaryTint}" />
                                        <Setter Property="Stroke" Value="{StaticResource PrimaryBrush}" />
                                    </DataTrigger>
                                </Border.Triggers>
                                <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="14">
                                    <Border Grid.Column="0"
                                            WidthRequest="32" HeightRequest="32"
                                            BackgroundColor="{StaticResource PrimaryTint}"
                                            StrokeThickness="0"
                                            StrokeShape="RoundRectangle 10"
                                            VerticalOptions="Center">
                                        <Label Text="✓"
                                               FontSize="18"
                                               FontAttributes="Bold"
                                               TextColor="{StaticResource Success}"
                                               HorizontalOptions="Center"
                                               VerticalOptions="Center"
                                               IsVisible="{Binding IsApproved}" />
                                        <Label Text="✗"
                                               FontSize="16"
                                               FontAttributes="Bold"
                                               TextColor="{StaticResource Error}"
                                               HorizontalOptions="Center"
                                               VerticalOptions="Center"
                                               IsVisible="{Binding IsRejected}" />
                                        <Label Text="…"
                                               FontSize="18"
                                               FontAttributes="Bold"
                                               TextColor="{StaticResource Primary}"
                                               HorizontalOptions="Center"
                                               VerticalOptions="Center"
                                               IsVisible="{Binding IsProcessing}" />
                                        <Image Source="ic_card.png"
                                               WidthRequest="18" HeightRequest="18"
                                               Aspect="AspectFit"
                                               HorizontalOptions="Center"
                                               VerticalOptions="Center"
                                               IsVisible="{Binding IsPending}" />
                                    </Border>

                                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                        <Label Text="{Binding Subtitle}"
                                               FontSize="14"
                                               CharacterSpacing="1"
                                               TextColor="{StaticResource TextPrimary}"
                                               LineBreakMode="TailTruncation" />
                                        <Label Text="{Binding StatusLabel}"
                                               FontSize="11"
                                               FontAttributes="Bold"
                                               TextColor="{StaticResource TextMuted}" />
                                        <Label Text="{Binding ResultDetail}"
                                               FontSize="11"
                                               TextColor="{StaticResource TextSecondary}"
                                               IsVisible="{Binding HasResultDetail}" />
                                    </VerticalStackLayout>

                                    <Label Grid.Column="2"
                                           Text="{Binding AmountText}"
                                           FontSize="15"
                                           FontAttributes="Bold"
                                           TextColor="{StaticResource TextPrimary}"
                                           VerticalOptions="Center" />

                                    <!-- Señal de que la fila es editable. Ya no es el objetivo del
                                         toque —lo es la fila entera—, así que no lleva gesto. -->
                                    <Label Grid.Column="3"
                                           Text="✎"
                                           FontSize="16"
                                           TextColor="{StaticResource TextMuted}"
                                           VerticalOptions="Center"
                                           IsVisible="{Binding IsRemovable}" />
                                </Grid>
                            </Border>
                            </SwipeView>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <!-- Envía el bono capturado a la lista.
                     Es un Button con el estilo global, NO un Border con un gesto encima. Como
                     Border no tenía estados visuales: al tocarlo se pintaba el fondo de presión
                     de Android y ese fondo se quedaba puesto, así que el botón parecía
                     deshabitado aunque seguía funcionando. PrimaryButton trae Normal/Pressed/
                     Disabled y la animación de presión común a toda la app. -->
                <Button Text="✓   Agregar a la lista"
                        Style="{StaticResource PrimaryButton}"
                        FontSize="15"
                        Margin="0,4,0,0"
                        Command="{Binding AddToQueueCommand}" />

                <!-- Error inline (reemplaza a los toasts) -->
                <Label Text="{Binding LastError}"
                       FontSize="12"
                       TextColor="{StaticResource Error}"
                       Margin="0,8,0,0"
                       IsVisible="{Binding HasLastError}" />

                <!-- Total + acciones del lote -->
                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="14" Margin="0,8,0,0">
                    <Label Grid.Column="0"
                           Text="{Binding TotalSummary}"
                           FontSize="12"
                           TextColor="{StaticResource TextSecondary}"
                           VerticalOptions="Center" />

                    <Button Grid.Column="1"
                            Text="↺  Limpiar"
                            Style="{StaticResource SecondaryButton}"
                            HeightRequest="50"
                            MinimumWidthRequest="165"
                            Command="{Binding ClearQueueCommand}"
                            IsEnabled="{Binding HasQueueItems}" />

                    <Button Grid.Column="2"
                            Text="{Binding ProcessButtonText}"
                            Style="{StaticResource PrimaryButton}"
                            FontSize="15"
                            HeightRequest="50"
                            MinimumWidthRequest="235"
                            Padding="34,0"
                            Command="{Binding ProcessQueueCommand}"
                            IsEnabled="{Binding CanProcessQueue}" />
                </Grid>

                <ActivityIndicator IsRunning="{Binding IsBusy}"
                                   IsVisible="{Binding IsBusy}"
                                   Color="{StaticResource Primary}" />
            </VerticalStackLayout>
        </ScrollView>

        <!-- Cierre de la operación: qué bono se cobró, por cuánto y con qué saldo quedó. -->
        <controls:ResultOverlayView Grid.Row="0" Grid.RowSpan="2"
                                    IsVisible="{Binding HasResult}"
                                    Headline="{Binding ResultHeadline}"
                                    Subline="{Binding ResultSubline}"
                                    IsSuccess="{Binding ResultIsSuccess}"
                                    Lines="{Binding ResultLines}"
                                    DismissCommand="{Binding DismissResultCommand}" />
    </Grid>
</ContentPage>
