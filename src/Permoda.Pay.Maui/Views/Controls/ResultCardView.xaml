<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:behaviors="clr-namespace:Permoda.Pay.Maui.Common.Behaviors"
             x:Class="Permoda.Pay.Maui.Views.Controls.ResultCardView"
             x:Name="Root">
    <Border x:Name="CardBorder" IsVisible="{Binding HasResult}" Padding="0"
            StrokeThickness="0" StrokeShape="RoundRectangle 22">
        <Border.Triggers>
            <DataTrigger TargetType="Border" Binding="{Binding State}" Value="ok">
                <Setter Property="Background">
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="{StaticResource Success}" Offset="0.0" />
                        <GradientStop Color="{StaticResource SuccessDeep}" Offset="1.0" />
                    </LinearGradientBrush>
                </Setter>
            </DataTrigger>
            <DataTrigger TargetType="Border" Binding="{Binding State}" Value="fail">
                <Setter Property="Background">
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="{StaticResource Error}" Offset="0.0" />
                        <GradientStop Color="{StaticResource ErrorDeep}" Offset="1.0" />
                    </LinearGradientBrush>
                </Setter>
            </DataTrigger>
        </Border.Triggers>

        <Grid Padding="22" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="8">
            <Grid Grid.Row="0" ColumnDefinitions="Auto,*">
                <Label Grid.Column="0" Text="{Binding Icon}" FontSize="34" FontAttributes="Bold"
                       TextColor="{StaticResource OnDark}" VerticalOptions="Center">
                    <Label.Behaviors>
                        <behaviors:PopInBehavior />
                    </Label.Behaviors>
                </Label>
                <Label Grid.Column="1" Text="{Binding Headline}" Margin="12,0,0,0"
                       FontSize="22" FontAttributes="Bold" TextColor="{StaticResource OnDark}"
                       VerticalOptions="Center" />
            </Grid>

            <Label Grid.Row="1" Text="{Binding MaskedCard}" FontSize="18"
                   TextColor="{StaticResource OnDark}" CharacterSpacing="2" />

            <Label Grid.Row="2" Text="{Binding BalanceText}" FontSize="15"
                   TextColor="{StaticResource OnHeroMuted}" />

            <Label Grid.Row="3" Text="{Binding Reference}" FontSize="13"
                   TextColor="{StaticResource OnHeroMuted}" />

            <Button Grid.Row="4" IsVisible="{Binding HasUrl}" Text="Ver comprobante del cliente"
                    BackgroundColor="Transparent" TextColor="{StaticResource OnDark}"
                    BorderColor="{StaticResource OnHeroMuted}" BorderWidth="1"
                    CornerRadius="20" Padding="14,6" HorizontalOptions="Start"
                    CommandParameter="{Binding Url}" />
        </Grid>
    </Border>
</ContentView>
